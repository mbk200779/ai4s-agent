# =============================================================================
# AI4S 学术研究 Agent — 环境变量模板
#
# 用法：cp .env.example .env，然后**至少**填写一个 LLM 的 API key。
# 其余项全部有可用默认值，不填也能启动（涉及 LLM 的功能会降级或报错）。
#
# 约定：
#   · 本文件只放占位符，真实密钥一律写进 .env（已被 .gitignore 忽略）；
#   · 密钥只通过环境变量注入，代码中不出现任何硬编码 key；
#   · 标「可选」的留空即可，标「必填」的不填则对应功能不可用。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 前端
# -----------------------------------------------------------------------------
# 浏览器端调用 API 的基地址。
#   本地开发：http://localhost:8000
#   经 gateway(:8080) 访问：由 nginx 同源转发 /api，可留空
#   公网域名：https://your-domain.com（同源转发）
NEXT_PUBLIC_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# 2. LLM（经 LiteLLM 统一抽象，可随时切换 provider / model）
#
# 三档分工，均支持 openai/… anthropic/… dashscope/… 前缀：
#   LITELLM_MODEL        主模型：问答、综述、跨文献推理
#   LITELLM_CHEAP_MODEL  降本模型：结构化抽取（章节树、参考文献拆条、图表说明）
#   LITELLM_VISION_MODEL 多模态：公式转 LaTeX、图表语义描述
# 三者可填同一模型，也可按成本拆开。
# -----------------------------------------------------------------------------
LITELLM_MODEL=openai/gpt-4o-mini
LITELLM_CHEAP_MODEL=openai/gpt-4o-mini
LITELLM_VISION_MODEL=openai/gpt-4o-mini

# 至少填一个（必填，按所用 provider 选择）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DASHSCOPE_API_KEY=

# -----------------------------------------------------------------------------
# 3. 向量库 Qdrant
# QDRANT_URL 由 docker-compose 注入为 http://qdrant:6333，无需在此设置。
# -----------------------------------------------------------------------------
QDRANT_COLLECTION=ai4s_papers
QDRANT_PAPER_META_COLLECTION=ai4s_paper_meta

# 嵌入线程数。8 为实测最优：不指定时 onnxruntime 按核数开线程，
# 单条短文本反而更慢（16 核默认 197~350ms，8 线程 40ms）。
EMBED_THREADS=8

# -----------------------------------------------------------------------------
# 4. 对象存储 MinIO
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_PAPERS=papers
MINIO_BUCKET_FIGURES=figures
MINIO_BUCKET_PROVENANCE=provenance

# -----------------------------------------------------------------------------
# 5. 任务队列 Redis
# REDIS_URL 由 docker-compose 注入为 redis://redis:6379/0，一般无需修改。
# -----------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# 6. 外部学术数据源
# -----------------------------------------------------------------------------
# Semantic Scholar（可选）。无 key 会被限流至约 1 req/s，图谱构建变慢。
S2_API_KEY=

# -----------------------------------------------------------------------------
# 7. 云端评审账号（仅部署到公网时需要）
# 演示地址若开启登录，评审用这组账号进入。
# -----------------------------------------------------------------------------
JUDGE_USERNAME=judge
JUDGE_PASSWORD=ai4s2024

# -----------------------------------------------------------------------------
# 8. 检索与重排（有默认值，按机器性能微调）
# -----------------------------------------------------------------------------
# 精排（cross-encoder）：对 RRF 融合后的候选做二次排序
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_TIMEOUT_MS=1500
# 语义分权重（alpha 越大越偏语义；0.2 表示以规则分为主，见 docs/2.9 实测表）
RERANK_ALPHA=0.2
# 数值/单位类问题的规则召回（如「β2 取多少」「BLEU 是多少」）
NUMERIC_RECALL_ENABLED=true
# 章节锚点召回：用章节树把查询锚到相关小节
ANCHOR_ENABLED=true

# -----------------------------------------------------------------------------
# 9. 置信分级（替代二值拒答）
# 分数 ≥ verified 判「已验证」，≥ needs_check 判「需核对」，低于则拒答
# -----------------------------------------------------------------------------
CONFIDENCE_VERIFIED_SCORE=0.55
CONFIDENCE_NEEDS_CHECK_SCORE=0.15
# 判「已验证」要求至少被几篇不同论文支撑
CONFIDENCE_CROSS_PAPER_MIN_SOURCES=2
# 一条证据句与原文的余弦下限，低于此值不算证据
CLAIM_MIN_EVIDENCE=0.15

# -----------------------------------------------------------------------------
# 10. 流式输出
# -----------------------------------------------------------------------------
STREAM_ENABLED=true
# SSE 心跳间隔（秒）。超过 2 个间隔无事件，前端判定连接半开并回落轮询。
STREAM_HEARTBEAT_S=8
# 是否把每次结构化输出写成 provenance 日志（排查用，关掉可省磁盘）
STREAM_LOG_ENABLED=true

# -----------------------------------------------------------------------------
# 11. 索引 pipeline 版本
# 每个版本对应一个独立 Qdrant collection，支持灰度切换与回滚。
# 升级 embedding 模型或分块策略时必须递增，否则新向量会写进旧集合。
# -----------------------------------------------------------------------------
PIPELINE_VERSION=v1.0.0

# -----------------------------------------------------------------------------
# 12. 复现性配置（不建议修改）
# -----------------------------------------------------------------------------
TEMPERATURE=0
PROMPT_VERSION=v1.0.0

# -----------------------------------------------------------------------------
# 13. 公网入口（可选，二选一或都开）
# -----------------------------------------------------------------------------
# Cloudflare 命名隧道 token。留空时 tunnel 容器不启动（profile 隔离）。
CLOUDFLARE_TUNNEL_TOKEN=
# cpolar 国内隧道 authtoken（https://dashboard.cpolar.com/auth）。
# Cloudflare 国际出口拥塞时的替代入口。
CPOLAR_AUTHTOKEN=

# -----------------------------------------------------------------------------
# 14. 解析资源（长文档导入时才会用到）
# -----------------------------------------------------------------------------
# 解析进程的 RSS 软上限（MiB）。超限时任务主动失败并保留现场，而不是等内核 OOM。
# 这个值要和机器内存配：7168 面向 16GB 机器（实测单篇峰值 6093MB，22 页 82 片段的 ViT）；
# 8GB 机器请设 4096 —— 模型基线约 2.6GB，再高就没有余量留给文档了。
INGEST_RSS_SOFT_LIMIT_MB=7168

# 扫描件 OCR。镜像内已装 tesseract（eng + chi_sim），默认开。
# 只在「本页没有文本层」时才触发，普通论文零开销。
# 关掉后纯图像 PDF（如官方用例 1706.03762v1_img.pdf）会解析成空文本。
INGEST_OCR_ENABLED=true
# 语言包：英文论文用 eng；中英混排可设 eng+chi_sim（更慢，约 1.5 倍）
INGEST_OCR_LANG=eng
# OCR 渲染精度。200 是速度与准确率的平衡点；公式密集的扫描件可提到 300
INGEST_OCR_DPI=200
